# =============================================================
# Variables de entorno — Visión Bolivia 2035
# Copiar a .env y reemplazar los valores marcados con CAMBIAR_*
# =============================================================
#
# DESARROLLO (local con Docker):
#   docker compose -f docker-compose.dev.yml up -d
#   App: http://localhost:23000
#
# PRODUCCIÓN (tu propia infra):
#   docker compose up -d --build
#   App: http://<tu-host>:8080  (poné un reverse proxy delante para TLS)
# =============================================================

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_GENERAR_CON_openssl_rand_base64_32
POSTGRES_DB=vision_bolivia_2035
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL de conexión Prisma (hostname "db" = servicio Docker)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db:5432/vision_bolivia_2035?schema=public

# Aplicación Next.js
NODE_ENV=development
PORT=3000
HOST_PORT=23000

# Seguridad (generar con: openssl rand -base64 32 | tr -d '/+=')
NEXTAUTH_SECRET=CAMBIAR_GENERAR_CON_openssl_rand_base64_32
NEXT_PUBLIC_API_URL=http://localhost:23000
