generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum OrganizationType {
  HOTEL_ALOJAMIENTO
  RESTAURANTE_GASTRONOMIA
  AGENCIA_OPERADOR
  PRESTADOR_SERVICIOS
  TRANSPORTE_TURISTICO
  GUIA_TURISTICO
  ARTESANO_PRODUCTOR
  COMUNIDAD_INDIGENA
  ORGANIZADOR_EVENTOS
  GOBIERNO_MUNICIPAL
  GOBIERNO_DEPARTAMENTAL
  AREA_PROTEGIDA
  ACADEMIA_INVESTIGACION
  ONG
  ESTUDIANTE
  OTRO
}

enum WorkshopDestination {
  LA_PAZ
  EL_ALTO
  COCHABAMBA
  SANTA_CRUZ
  TRINIDAD
  COBIJA
  ORURO
  POTOSI
  SUCRE
  TARIJA
  UYUNI
  RURRENABAQUE
  COPACABANA
  CONCEPCION_MISIONES
  TIWANAKU
  VILLATUNARI_TROPICO
  SAMAIPATA
  CAMIRI
  COROICO_NORTE_LA_PAZ
  VILLA_MONTES
}

enum TourismExperience {
  MENOS_1_ANIO
  DE_1_A_3
  DE_3_A_10
  MAS_DE_10
}

enum TriState {
  SI
  NO
  NO_SE
}

// ============================================================
// FORMULARIO 1: REGISTRO DE PARTICIPANTE
// ============================================================

model Participant {
  id               String              @id @default(cuid())
  fullName         String              @map("full_name")
  whatsapp         String
  email            String
  organization     String?
  organizationType OrganizationType    @map("organization_type")
  destination      WorkshopDestination
  experience       TourismExperience
  tourismImportance Int                @map("tourism_importance") // 1-5
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  survey           Survey?

  @@map("participants")
}

// ============================================================
// FORMULARIO 2: ENCUESTA PRE-TALLER (multi-sección)
// ============================================================

model Survey {
  id            String @id @default(cuid())
  participantId String @unique @map("participant_id")
  participant   Participant @relation(fields: [participantId], references: [id])

  // --- Sección 2: Ecosistema turístico (bloques 1-11, valores 1-5) ---
  // Se almacena como JSON por la cantidad de campos (50+ preguntas escala 1-5)
  ecosystemRatings Json @map("ecosystem_ratings")
  // Campos booleanos/tristate separados
  hasAirport             Boolean?  @map("has_airport")
  hasBusTerminal         Boolean?  @map("has_bus_terminal")
  hasProtectedAreas      TriState? @map("has_protected_areas")
  mobilityObservations   String?   @map("mobility_observations")

  // --- Sección 3: Mercado ---
  currentMarkets    String[] @map("current_markets")   // hasta 3 países
  potentialMarkets  String[] @map("potential_markets")  // hasta 3 países

  // --- Sección 4: Identidad del destino ---
  destinationPride      String?  @map("destination_pride")
  naturalElements       String?  @map("natural_elements")
  culturalElements      String?  @map("cultural_elements")
  uniqueExperience      String?  @map("unique_experience")
  differentiator        String?  @map("differentiator")
  visitorMessage        String?  @map("visitor_message")

  // --- Sección 5: Identidad Bolivia ---
  boliviaOneWord        String?  @map("bolivia_one_word")
  boliviaUnique         String?  @map("bolivia_unique")
  visitMotivation       String?  @map("visit_motivation")
  boliviaPerception     String?  @map("bolivia_perception")

  // --- Sección Final: Comentarios ---
  mainProblems          String?  @map("main_problems")
  keyOpportunities      String?  @map("key_opportunities")
  priorityProject       String?  @map("priority_project")
  sustainabilityChange  String?  @map("sustainability_change")
  tourismPriorities     String[] @map("tourism_priorities") // hasta 3

  // --- Bloque 12: Visión 2035 ---
  tourismTypes2035       String[] @map("tourism_types_2035") // hasta 3
  referenceDestination   String?  @map("reference_destination")
  structuralChange       String?  @map("structural_change")

  // Metadata
  completedSections Int      @default(0) @map("completed_sections") // para tracking de progreso
  isComplete        Boolean  @default(false) @map("is_complete")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("surveys")
}

// ============================================================
// TALLERES
// ============================================================

model Workshop {
  id           String              @id @default(cuid())
  name         String
  description  String?
  destination  WorkshopDestination
  city         String
  address      String?
  date         DateTime
  capacity     Int                 @default(50)
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@map("workshops")
}

// ============================================================
// CONTACTO
// ============================================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}
